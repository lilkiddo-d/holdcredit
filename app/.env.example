# Which deployment to use: 4663 (Robinhood Chain mainnet) or 31337 (local anvil fork)
NEXT_PUBLIC_CHAIN_ID=4663
# RPC (public endpoint is rate-limited; use Alchemy/QuickNode in production)
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# WalletConnect Cloud project id (optional; injected wallets work without it)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# $HOLD project token address. EMPTY = all token features hidden.
NEXT_PUBLIC_PROJECT_TOKEN=
# Optional geoblock (ISO country codes, comma separated). Empty = off.
# Stock tokens may not be offered to US persons and are restricted in other jurisdictions.
GEOBLOCK_COUNTRIES=US,CA,GB,CH
# Local fork only: expose a "Fork dev wallet" connector backed by anvil --auto-impersonate
NEXT_PUBLIC_ENABLE_FORK_WALLET=false
NEXT_PUBLIC_FORK_DEV_ACCOUNT=
